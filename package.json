{
  "name": "allyguide-bystander-support-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Research demonstrator: optional, context-sensitive guidance for bystanders who witness gendered online harassment. Not a validated intervention.",
  "license": "MIT",
  "author": "Rumana Akter",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run check:secrets && npm test && npm run build && npm run typecheck && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "postcss": "8.5.31"
  }
}
