# AllyGuide configuration. Copy to .env.local for local use. Never commit a real key.

# Live model mode is OFF by default. The deterministic demo needs no key and no network.
# Set to "on" only if you want the optional server-side language-model mode.
ALLYGUIDE_LIVE_MODEL=off

# Server-side only. Read by the API route; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional model override for live mode (default: claude-haiku-4-5).
ALLYGUIDE_MODEL=
